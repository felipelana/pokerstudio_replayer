# The single entry point for the host. One Caddy owns 80 and 443, issues a
# certificate per hostname over HTTP-01 (no wildcard, no DNS credentials), and
# hands each request to the container of the right environment. The names it
# proxies to — web-prod, api-staging, and so on — are network aliases declared
# in docker-compose.prod.yml and docker-compose.staging.yml.

{
	email {$ACME_EMAIL}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

# Staging is not for the public: a password at the door, and a header that keeps
# it out of search results even if someone shares the link.
(staging_gate) {
	basic_auth {
		{$STAGING_USER} {$STAGING_PASSWORD_HASH}
	}
	header X-Robots-Tag "noindex, nofollow"
}

# ---------------------------------------------------------------- production --

replayer.pokerstudio.com.br {
	encode zstd gzip

	# The API keeps its own prefix; everything else is the static replayer.
	handle /api/* {
		reverse_proxy api-prod:3001
	}

	handle {
		reverse_proxy web-prod:80
	}

	import security_headers
}

pokerstudio.com.br, www.pokerstudio.com.br {
	encode zstd gzip
	reverse_proxy landing-prod:80
	import security_headers
}

# ------------------------------------------------------------------- staging --

stage.replayer.pokerstudio.com.br {
	encode zstd gzip

	# The deploy pipeline checks this before letting a release stand, so it is
	# the one path that answers without a password.
	handle /api/v1/health {
		header X-Robots-Tag "noindex, nofollow"
		reverse_proxy api-staging:3001
	}

	handle /api/* {
		import staging_gate
		reverse_proxy api-staging:3001
	}

	handle {
		import staging_gate
		reverse_proxy web-staging:80
	}

	import security_headers
}

web.replayer.pokerstudio.com.br {
	encode zstd gzip
	import staging_gate
	reverse_proxy landing-staging:80
	import security_headers
}
