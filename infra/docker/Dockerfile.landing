# ---- build the landing page from the monorepo root ----
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
# Every workspace manifest, because npm ci checks the whole tree against the
# lockfile even when only one workspace is being installed.
COPY apps/web/package.json apps/web/
COPY apps/api/package.json apps/api/
COPY packages/shared/package.json packages/shared/
COPY landingpage/package.json landingpage/
RUN npm ci --no-audit --no-fund --workspace @pokerstudio/landingpage --include-workspace-root
COPY landingpage landingpage
RUN npm run check:locales -w @pokerstudio/landingpage && npm run build -w @pokerstudio/landingpage

# ---- serve ----
FROM nginx:1.27-alpine
COPY infra/docker/nginx.landing.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/landingpage/dist /usr/share/nginx/html
# Staging asks search engines to stay away; production keeps the committed file.
# ROBOTS_POLICY=noindex swaps it at start-up, so one image serves both hosts.
COPY infra/docker/robots-entrypoint.sh /docker-entrypoint.d/40-robots.sh
RUN chmod +x /docker-entrypoint.d/40-robots.sh
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
