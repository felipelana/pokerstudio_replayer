# Copy to /opt/pokerstudio/prod/.env on the server and fill every value.
# chmod 600: this file is the whole of production's secrets.

APP_ENV=production

# Written by the deploy pipeline on every release. The values here are only a
# starting point so `docker compose up` works before the first deploy.
APP_IMAGE=ghcr.io/felipelana/pokerstudio_replayer/app:latest
APP_VERSION=0.0.0
APP_COMMIT=unknown
APP_BUILT_AT=

# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -hex 32   (at least 32 characters)
SESSION_SECRET=
# openssl rand -hex 32   (exactly 64 hex characters)
ENCRYPTION_KEY=

APP_URL=https://replayer.pokerstudio.com.br
# Deliberately empty: a host-only cookie cannot reach production.
COOKIE_DOMAIN=
ADMIN_EMAILS=felipelana@gmail.com

EMAIL_FROM=nao-responda@pokerstudio.com.br
EMAIL_FROM_NAME=PokerStudio Replayer
# Empty keeps every message in the outbox instead of sending it. On production, set the real key. On staging
# that is usually what you want.
EMAIL_PROVIDER_KEY=
TURNSTILE_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://replayer.pokerstudio.com.br/api/v1/auth/google/callback

ROBOTS_POLICY=index
ERROR_LOG_RETENTION_DAYS=30
