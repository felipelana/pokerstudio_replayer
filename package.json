{
  "name": "pokerstudio_replayer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "landingpage"
  ],
  "scripts": {
    "dev": "next dev --port 3100",
    "prebuild": "node infra/scripts/check-no-dev-server.mjs",
    "build": "next build",
    "start": "next start",
    "dev:vite": "vite",
    "build:vite": "vite build",
    "preview:vite": "vite preview",
    "dev:api": "tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local src/server/main.ts",
    "dev:landing": "npm run dev -w @pokerstudio/landingpage",
    "build:landing": "npm run build -w @pokerstudio/landingpage",
    "test": "npm run test:web && npm run test:server",
    "test:web": "vitest run",
    "test:web:watch": "vitest",
    "test:server": "vitest run -c vitest.server.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"packages/**/src/**/*.ts\"",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "changelog": "node infra/scripts/changelog.mjs",
    "changelog:check": "node infra/scripts/changelog.mjs --check",
    "check:copy": "node infra/scripts/check-copy.mjs",
    "check:locales": "node infra/scripts/check-locales.mjs",
    "check:api-docs": "node infra/scripts/check-api-docs.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@node-rs/argon2": "^2.0.2",
    "@pokerstudio/shared": "*",
    "@prisma/client": "^5.22.0",
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "@tanstack/react-virtual": "^3.10.8",
    "clsx": "^2.1.1",
    "dexie": "^4.0.9",
    "docx": "^9.7.1",
    "fastify": "^5.1.0",
    "i18next": "^23.16.4",
    "i18next-browser-languagedetector": "^8.0.0",
    "jspdf": "^4.2.1",
    "libphonenumber-js": "^1.11.14",
    "next": "^14.2.18",
    "otplib": "^12.0.1",
    "pino": "^9.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.0",
    "react-router-dom": "^6.27.0",
    "three": "^0.169.0",
    "ua-parser-js": "^1.0.39",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^8.12.2",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.5.2",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true,
    "prisma@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "@prisma/client@5.22.0": true,
    "core-js@3.50.0": true
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
