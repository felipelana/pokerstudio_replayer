{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["../web/src/*"],
      "@pokerstudio/shared": ["../../packages/shared/src/index.ts"],
      "@pokerstudio/api/*": ["../api/src/*"],
      "@landing/*": ["../../landingpage/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "../web/src/**/*.ts", "../web/src/**/*.tsx", "../api/src/types.d.ts"],
  "exclude": ["node_modules"]
}
