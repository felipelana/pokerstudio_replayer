// PokerStudio — accounts, access log, reviews and per-user skins.
// Every change here is a versioned migration under prisma/migrations.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
  DELETED
}

enum UserRole {
  USER
  ADMIN
}

enum UserPlan {
  FREE
  PAID
}

enum AuthProvider {
  PASSWORD
  GOOGLE
  FACEBOOK
  APPLE
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
  CHANGE_EMAIL
}

enum AccessEvent {
  LOGIN_OK
  LOGIN_FAIL
  LOGOUT
  SIGNUP
  VERIFY
  RESET_REQUEST
  RESET_OK
  BLOCKED_ATTEMPT
  ADMIN_BLOCK
  ADMIN_UNBLOCK
  SESSION_REVOKE
  ADMIN_LOGIN_OK
  ADMIN_LOGIN_FAIL
  TOTP_ENROLL_STARTED
  TOTP_ENROLLED
  TOTP_OK
  TOTP_FAIL
  TOTP_DISABLED
  RECOVERY_CODE_USED
  PROFILE_UPDATED
  ACCOUNT_DELETED
  EMAIL_SETTINGS_CHANGED
  GOOGLE_LINKED
  GOOGLE_UNLINKED
  PROVIDER_LINKED
  PROVIDER_UNLINKED
}

enum DeviceType {
  MOBILE
  TABLET
  DESKTOP
  BOT
  UNKNOWN
}

enum ReferralChannel {
  WHATSAPP
  EMAIL
  LINK
}

enum TwoFactorType {
  TOTP
  EMAIL
}

enum ReviewStatus {
  IN_PROGRESS
  COMPLETED
}

enum HandOutcome {
  WON
  LOST
  FOLDED
}

enum UsageEventType {
  APP_OPEN
  HAND_IMPORT
  REVIEW_START
  REVIEW_SAVE
  REVIEW_RESUME
  REVIEW_COMPLETE
  REPORT_EXPORT
  SKIN_APPLIED
  SKIN_SAVED
}

/// Who wrote an assessment: the player themselves, or one invited coach.
enum AssessorRole {
  SELF
  COACH
}

enum AssessmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum FeedbackKind {
  SUGGESTION
  IMPROVEMENT
  PROBLEM
  OTHER
}

enum FeedbackStatus {
  NEW
  READ
  PLANNED
  DONE
  DECLINED
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique @db.Citext
  emailVerifiedAt DateTime?
  /// Optional: an account created through Google has no password until it sets one.
  passwordHash    String?
  name            String
  phoneE164       String?
  phoneCountry    String?    @db.Char(2)
  countryCode     String     @db.Char(2)
  language        String     @db.VarChar(8)
  status          UserStatus @default(PENDING)
  blockedReason   String?
  blockedAt       DateTime?
  blockedById     String?
  role            UserRole   @default(USER)
  plan            UserPlan   @default(FREE)
  planSince       DateTime?
  referralCode    String     @unique @db.VarChar(8)
  referredById    String?
  termsAcceptedAt DateTime?
  marketingOptIn  Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  blockedBy      User?           @relation("BlockedBy", fields: [blockedById], references: [id])
  blockedUsers   User[]          @relation("BlockedBy")
  referredBy     User?           @relation("ReferredBy", fields: [referredById], references: [id])
  referredUsers  User[]          @relation("ReferredBy")
  sessions       Session[]
  identities     AuthIdentity[]
  emailTokens    EmailToken[]
  accessLogs     AccessLog[]
  errorLogs      ErrorLog[]
  referrals      Referral[]      @relation("Referrer")
  twoFactor      TwoFactor[]
  recoveryCodes  RecoveryCode[]
  trustedDevs    TrustedDevice[]
  reviews        ReviewSession[]
  skins          UserSkin[]
  usage          UsageEvent[]
  feedback       Feedback[]
  roomNicks      RoomNick[]
  assessments    Assessment[]
  coachInvites   CoachInvite[]   @relation("InviteAuthor")
  claimedInvites CoachInvite[]   @relation("InviteClaimant")

  @@index([status, createdAt])
  @@index([countryCode])
}

model AuthIdentity {
  id             String       @id @default(uuid())
  userId         String
  provider       AuthProvider
  providerUserId String
  email          String       @db.Citext
  avatarUrl      String?
  createdAt      DateTime     @default(now())
  lastLoginAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Session {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String    @unique
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  lastSeenAt  DateTime  @default(now())
  ip          String?   @db.Inet
  userAgent   String?
  /// Admin sessions only open once the second factor was checked.
  twoFactorAt DateTime?
  revokedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model EmailToken {
  id        String         @id @default(uuid())
  userId    String
  type      EmailTokenType
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model AccessLog {
  id             BigInt      @id @default(autoincrement())
  userId         String?
  email          String?     @db.Citext
  event          AccessEvent
  ip             String?     @db.Inet
  country        String?     @db.Char(2)
  userAgent      String?
  deviceType     DeviceType  @default(UNKNOWN)
  os             String?
  browser        String?
  browserVersion String?
  /// Where the request came from (referrer / entry point).
  origin         String?
  /// Which tool of the kit produced the event.
  appSurface     String?
  detail         Json?
  createdAt      DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([event, createdAt])
}

model LoginAttempt {
  /// "email:<address>" or "ip:<address>"
  key         String    @id
  count       Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
}

model Referral {
  id           String          @id @default(uuid())
  referrerId   String
  channel      ReferralChannel
  inviteeEmail String?         @db.Citext
  inviteePhone String?
  code         String          @db.VarChar(8)
  sentAt       DateTime        @default(now())
  acceptedById String?
  acceptedAt   DateTime?

  referrer User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@index([code])
}

model TwoFactor {
  id           String        @id @default(uuid())
  userId       String
  type         TwoFactorType
  /// AES-256-GCM ciphertext; never leaves the server in clear.
  secretEnc    String?
  confirmedAt  DateTime?
  /// Last accepted TOTP step, so a code cannot be replayed.
  lastUsedStep BigInt?
  createdAt    DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model RecoveryCode {
  id       String    @id @default(uuid())
  userId   String
  codeHash String    @unique
  usedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TrustedDevice {
  id          String   @id @default(uuid())
  userId      String
  tokenHash   String   @unique
  deviceLabel String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A review the user can resume where they left off (5C).
model ReviewSession {
  id                 String       @id @default(uuid())
  userId             String
  title              String
  sourceFileName     String?
  roomDetected       String?
  handCount          Int          @default(0)
  currentHandIndex   Int          @default(0)
  currentActionIndex Int?
  status             ReviewStatus @default(IN_PROGRESS)
  /// The user chose to keep the raw hand history on the server.
  storeHandHistory   Boolean      @default(false)
  lastOpenedAt       DateTime     @default(now())
  completedAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  hands       HandRecord[]
  assessments Assessment[]
  invites     CoachInvite[]

  @@index([userId, lastOpenedAt])
}

model HandRecord {
  id              String       @id @default(uuid())
  reviewSessionId String
  index           Int
  handId          String?
  /// Only stored when the user opted in.
  rawHistory      String?
  heroPosition    String?
  /// Whether the hero voluntarily put money in this hand. Null on rows saved
  /// before coverage existed — unknown, not false.
  heroVpip        Boolean?
  result          HandOutcome?
  potWon          Decimal?     @db.Decimal(18, 2)
  reviewedAt      DateTime?

  session     ReviewSession    @relation(fields: [reviewSessionId], references: [id], onDelete: Cascade)
  notes       ReviewNote[]
  assessments HandAssessment[]

  @@unique([reviewSessionId, index])
}

model ReviewNote {
  id              String   @id @default(uuid())
  handRecordId    String
  tags            String[]
  body            String
  includeInReport Boolean  @default(false)
  /// NONE | TEXT | IMAGE
  capture         String   @default("NONE")
  imageRef        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  hand HandRecord @relation(fields: [handRecordId], references: [id], onDelete: Cascade)

  @@index([handRecordId])
}

/// A skin saved to the user's account, so it follows them across devices.
model UserSkin {
  id        String   @id @default(uuid())
  userId    String
  /// Skin id used by the client (stable across saves).
  skinId    String
  name      String
  /// The whole Skin object, as the replayer serialises it.
  data      Json
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skinId])
  @@index([userId, updatedAt])
}

model UsageEvent {
  id        BigInt         @id @default(autoincrement())
  userId    String?
  /// Anonymous id, only set when the visitor accepted measurement cookies.
  anonId    String?
  type      UsageEventType
  skinId    String?
  meta      Json?
  createdAt DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([userId, createdAt])
}

/// Daily rollup so the dashboard never scans the raw event table.
model MetricDaily {
  day    DateTime @db.Date
  metric String
  value  Int      @default(0)

  @@id([day, metric])
}

/// Messages waiting for an email provider to be configured (5B.5).
model EmailOutbox {
  id        String       @id @default(uuid())
  to        String       @db.Citext
  template  String
  locale    String       @db.VarChar(8)
  payload   Json
  status    OutboxStatus @default(PENDING)
  attempts  Int          @default(0)
  lastError String?
  createdAt DateTime     @default(now())
  sentAt    DateTime?

  @@index([status, createdAt])
}

/// Email provider configuration, edited in /admstudio. Secrets are encrypted.
model EmailSettings {
  id                  Int       @id @default(1)
  provider            String    @default("NONE")
  fromAddress         String?
  fromName            String?
  replyTo             String?
  /// AES-256-GCM ciphertext.
  secretEnc           String?
  smtpHost            String?
  smtpPort            Int?
  smtpUser            String?
  smtpSecure          Boolean   @default(true)
  /// Accounts are usable before verifying while no provider is configured.
  requireVerification Boolean   @default(false)
  lastError           String?
  lastTestAt          DateTime?
  updatedAt           DateTime  @updatedAt
}

/// What a reader asked for: a suggestion, an improvement, a problem they hit.
/// Kept even if the account goes, because the idea outlives the account.
model Feedback {
  id         String         @id @default(uuid())
  userId     String?
  kind       FeedbackKind   @default(SUGGESTION)
  subject    String         @db.VarChar(200)
  body       String
  status     FeedbackStatus @default(NEW)
  /// What the team decided, read only by the team.
  adminNote  String?
  /// Where it was written from, to place a report in its context.
  appSurface String?        @db.VarChar(40)
  appVersion String?        @db.VarChar(40)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId])
}

/// The screen name this account plays under in one room. Optional, and worth a
/// lot: it is how a hand history written by any site can be recognised as
/// belonging to the reader, whatever the file says.
model RoomNick {
  id       String @id @default(uuid())
  userId   String
  /// Room key: the parser's own for rooms that have one, otherwise the
  /// catalogue id (packages/shared/src/rooms.ts) — ignition, winamax…
  room     String @db.VarChar(24)
  nickname String @db.VarChar(60)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, room])
  @@index([nickname])
}

/// One person's reading of one imported session, kept apart from everyone
/// else's. The player has exactly one (SELF); each invited coach has their own,
/// and neither can see nor touch the other.
model Assessment {
  id                String           @id @default(uuid())
  reviewSessionId   String
  role              AssessorRole
  /// Set for SELF: the account whose reading this is.
  userId            String?
  /// Set for COACH: the invitation this reading belongs to.
  coachInviteId     String?          @unique
  status            AssessmentStatus @default(NOT_STARTED)
  /// Where this assessor stopped, so each one resumes on their own hand.
  currentHandIndex  Int              @default(0)
  currentFrameIndex Int              @default(0)
  /// Once set, nothing in this assessment may change again.
  completedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  session ReviewSession    @relation(fields: [reviewSessionId], references: [id], onDelete: Cascade)
  user    User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  invite  CoachInvite?     @relation(fields: [coachInviteId], references: [id], onDelete: Cascade)
  hands   HandAssessment[]

  /// One self-assessment per account per session.
  @@unique([reviewSessionId, role, userId])
  @@index([reviewSessionId])
}

/// What one assessor said about one hand. A score of 0 is a real score; no
/// score at all is null, and the two must never be confused.
model HandAssessment {
  id             String   @id @default(uuid())
  assessmentId   String
  handRecordId   String
  /// 0..100, or null for no score.
  score          Int?
  /// Read and accepted as played, with no score and no comment needed.
  markedOk       Boolean  @default(false)
  comment        String?
  /// Comments per street: { preflop, flop, turn, river }.
  streetComments Json?
  /// Tag ids from the player's own list, as they stood when written.
  tags           String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  hand       HandRecord @relation(fields: [handRecordId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, handRecordId])
  @@index([assessmentId])
}

/// A temporary way in for one coach: a link, a password, and a deadline. No
/// account, no e-mail — the player hands both over however they like.
model CoachInvite {
  id              String    @id @default(uuid())
  reviewSessionId String
  createdById     String
  /// The name the player typed. Two coaches may share it; their ids do not.
  coachName       String    @db.VarChar(80)
  /// Unpredictable, and the only thing that travels in a URL.
  token           String    @unique @db.VarChar(64)
  /// Argon2id. The password itself is never stored, logged or put in a URL.
  passwordHash    String
  expiresAt       DateTime
  revokedAt       DateTime?
  /// When set, the link opens one hand of the review instead of all of it.
  /// The number is the hand position in the session, the same one an
  /// assessment files its notes under.
  handIndex       Int?
  /// Kept for a future coach account to claim this invitation.
  claimedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  session    ReviewSession @relation(fields: [reviewSessionId], references: [id], onDelete: Cascade)
  createdBy  User          @relation("InviteAuthor", fields: [createdById], references: [id], onDelete: Cascade)
  claimedBy  User?         @relation("InviteClaimant", fields: [claimedByUserId], references: [id])
  assessment Assessment?

  @@index([reviewSessionId])
  @@index([expiresAt])
}

/// The words that go with a score. Administered, and never applied backwards:
/// a score already given keeps its number whatever the bands become.
model RubricBand {
  id          String   @id @default(uuid())
  minScore    Int
  maxScore    Int
  description String   @db.VarChar(200)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([minScore])
}

/// How long a coach link may last. One row, id 1.
model ShareSettings {
  id           Int      @id @default(1)
  /// Hours a new link lasts unless the player picks otherwise.
  defaultHours Int      @default(24)
  /// The furthest a player may push a link out.
  maxHours     Int      @default(168)
  updatedAt    DateTime @updatedAt
}

/// Where a failure was noticed. The server sees its own exceptions; the browser
/// reports what only it can see — a render that threw, a promise nobody caught.
enum ErrorSource {
  SERVER
  CLIENT
}

enum ErrorLevel {
  WARN
  ERROR
  FATAL
}

/// A failure worth an administrator's attention, kept long enough to find a
/// pattern in it and no longer. What is stored is what helps to reproduce the
/// fault — never a credential, a cookie or a body: the redaction happens before
/// a row is ever written.
model ErrorLog {
  id         BigInt      @id @default(autoincrement())
  source     ErrorSource @default(SERVER)
  level      ErrorLevel  @default(ERROR)
  /// Which deployment produced it: staging and production share a schema, not a story.
  env        String      @db.VarChar(20)
  /// The release it happened on, so a fix can be told from a regression.
  release    String?     @db.VarChar(80)
  message    String      @db.VarChar(500)
  stack      String?
  /// Method and path, with the ids taken out, so the same fault groups together.
  route      String?     @db.VarChar(200)
  statusCode Int?
  /// Ties a row to the response the person actually saw.
  requestId  String?     @db.VarChar(60)
  userId     String?
  ip         String?     @db.Inet
  userAgent  String?     @db.VarChar(300)
  /// Anything else that helps, already redacted.
  context    Json?
  createdAt  DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([level, createdAt])
  @@index([env, createdAt])
  @@index([source, createdAt])
}
