// PokerStudio — accounts, access log, reviews and per-user skins.
// Every change here is a versioned migration under prisma/migrations.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
  DELETED
}

enum UserRole {
  USER
  ADMIN
}

enum UserPlan {
  FREE
  PAID
}

enum AuthProvider {
  PASSWORD
  GOOGLE
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
  CHANGE_EMAIL
}

enum AccessEvent {
  LOGIN_OK
  LOGIN_FAIL
  LOGOUT
  SIGNUP
  VERIFY
  RESET_REQUEST
  RESET_OK
  BLOCKED_ATTEMPT
  ADMIN_BLOCK
  ADMIN_UNBLOCK
  SESSION_REVOKE
  ADMIN_LOGIN_OK
  ADMIN_LOGIN_FAIL
  TOTP_ENROLLED
  TOTP_FAIL
  RECOVERY_CODE_USED
  EMAIL_SETTINGS_CHANGED
  GOOGLE_LINKED
  GOOGLE_UNLINKED
}

enum DeviceType {
  MOBILE
  TABLET
  DESKTOP
  BOT
  UNKNOWN
}

enum ReferralChannel {
  WHATSAPP
  EMAIL
  LINK
}

enum TwoFactorType {
  TOTP
  EMAIL
}

enum ReviewStatus {
  IN_PROGRESS
  COMPLETED
}

enum HandOutcome {
  WON
  LOST
  FOLDED
}

enum UsageEventType {
  APP_OPEN
  HAND_IMPORT
  REVIEW_START
  REVIEW_SAVE
  REVIEW_RESUME
  REVIEW_COMPLETE
  REPORT_EXPORT
  SKIN_APPLIED
  SKIN_SAVED
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique @db.Citext
  emailVerifiedAt DateTime?
  /// Optional: an account created through Google has no password until it sets one.
  passwordHash    String?
  name            String
  phoneE164       String?
  phoneCountry    String?    @db.Char(2)
  countryCode     String     @db.Char(2)
  language        String     @db.VarChar(8)
  status          UserStatus @default(PENDING)
  blockedReason   String?
  blockedAt       DateTime?
  blockedById     String?
  role            UserRole   @default(USER)
  plan            UserPlan   @default(FREE)
  planSince       DateTime?
  referralCode    String     @unique @db.VarChar(8)
  referredById    String?
  termsAcceptedAt DateTime?
  marketingOptIn  Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  blockedBy     User?           @relation("BlockedBy", fields: [blockedById], references: [id])
  blockedUsers  User[]          @relation("BlockedBy")
  referredBy    User?           @relation("ReferredBy", fields: [referredById], references: [id])
  referredUsers User[]          @relation("ReferredBy")
  sessions      Session[]
  identities    AuthIdentity[]
  emailTokens   EmailToken[]
  accessLogs    AccessLog[]
  referrals     Referral[]      @relation("Referrer")
  twoFactor     TwoFactor[]
  recoveryCodes RecoveryCode[]
  trustedDevs   TrustedDevice[]
  reviews       ReviewSession[]
  skins         UserSkin[]
  usage         UsageEvent[]

  @@index([status, createdAt])
  @@index([countryCode])
}

model AuthIdentity {
  id             String       @id @default(uuid())
  userId         String
  provider       AuthProvider
  providerUserId String
  email          String       @db.Citext
  avatarUrl      String?
  createdAt      DateTime     @default(now())
  lastLoginAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Session {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String    @unique
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  lastSeenAt  DateTime  @default(now())
  ip          String?   @db.Inet
  userAgent   String?
  /// Admin sessions only open once the second factor was checked.
  twoFactorAt DateTime?
  revokedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model EmailToken {
  id        String         @id @default(uuid())
  userId    String
  type      EmailTokenType
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model AccessLog {
  id             BigInt      @id @default(autoincrement())
  userId         String?
  email          String?     @db.Citext
  event          AccessEvent
  ip             String?     @db.Inet
  country        String?     @db.Char(2)
  userAgent      String?
  deviceType     DeviceType  @default(UNKNOWN)
  os             String?
  browser        String?
  browserVersion String?
  /// Where the request came from (referrer / entry point).
  origin         String?
  /// Which tool of the kit produced the event.
  appSurface     String?
  detail         Json?
  createdAt      DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([event, createdAt])
}

model LoginAttempt {
  /// "email:<address>" or "ip:<address>"
  key         String    @id
  count       Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
}

model Referral {
  id           String          @id @default(uuid())
  referrerId   String
  channel      ReferralChannel
  inviteeEmail String?         @db.Citext
  inviteePhone String?
  code         String          @db.VarChar(8)
  sentAt       DateTime        @default(now())
  acceptedById String?
  acceptedAt   DateTime?

  referrer User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@index([code])
}

model TwoFactor {
  id           String        @id @default(uuid())
  userId       String
  type         TwoFactorType
  /// AES-256-GCM ciphertext; never leaves the server in clear.
  secretEnc    String?
  confirmedAt  DateTime?
  /// Last accepted TOTP step, so a code cannot be replayed.
  lastUsedStep BigInt?
  createdAt    DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model RecoveryCode {
  id       String    @id @default(uuid())
  userId   String
  codeHash String    @unique
  usedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TrustedDevice {
  id          String   @id @default(uuid())
  userId      String
  tokenHash   String   @unique
  deviceLabel String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A review the user can resume where they left off (5C).
model ReviewSession {
  id                 String       @id @default(uuid())
  userId             String
  title              String
  sourceFileName     String?
  roomDetected       String?
  handCount          Int          @default(0)
  currentHandIndex   Int          @default(0)
  currentActionIndex Int?
  status             ReviewStatus @default(IN_PROGRESS)
  /// The user chose to keep the raw hand history on the server.
  storeHandHistory   Boolean      @default(false)
  lastOpenedAt       DateTime     @default(now())
  completedAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  hands HandRecord[]

  @@index([userId, lastOpenedAt])
}

model HandRecord {
  id              String       @id @default(uuid())
  reviewSessionId String
  index           Int
  handId          String?
  /// Only stored when the user opted in.
  rawHistory      String?
  heroPosition    String?
  result          HandOutcome?
  potWon          Decimal?     @db.Decimal(18, 2)
  reviewedAt      DateTime?

  session ReviewSession @relation(fields: [reviewSessionId], references: [id], onDelete: Cascade)
  notes   ReviewNote[]

  @@unique([reviewSessionId, index])
}

model ReviewNote {
  id              String   @id @default(uuid())
  handRecordId    String
  tags            String[]
  body            String
  includeInReport Boolean  @default(false)
  /// NONE | TEXT | IMAGE
  capture         String   @default("NONE")
  imageRef        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  hand HandRecord @relation(fields: [handRecordId], references: [id], onDelete: Cascade)

  @@index([handRecordId])
}

/// A skin saved to the user's account, so it follows them across devices.
model UserSkin {
  id        String   @id @default(uuid())
  userId    String
  /// Skin id used by the client (stable across saves).
  skinId    String
  name      String
  /// The whole Skin object, as the replayer serialises it.
  data      Json
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skinId])
  @@index([userId, updatedAt])
}

model UsageEvent {
  id        BigInt         @id @default(autoincrement())
  userId    String?
  /// Anonymous id, only set when the visitor accepted measurement cookies.
  anonId    String?
  type      UsageEventType
  skinId    String?
  meta      Json?
  createdAt DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([userId, createdAt])
}

/// Daily rollup so the dashboard never scans the raw event table.
model MetricDaily {
  day    DateTime @db.Date
  metric String
  value  Int      @default(0)

  @@id([day, metric])
}

/// Messages waiting for an email provider to be configured (5B.5).
model EmailOutbox {
  id        String       @id @default(uuid())
  to        String       @db.Citext
  template  String
  locale    String       @db.VarChar(8)
  payload   Json
  status    OutboxStatus @default(PENDING)
  attempts  Int          @default(0)
  lastError String?
  createdAt DateTime     @default(now())
  sentAt    DateTime?

  @@index([status, createdAt])
}

/// Email provider configuration, edited in /admstudio. Secrets are encrypted.
model EmailSettings {
  id                  Int       @id @default(1)
  provider            String    @default("NONE")
  fromAddress         String?
  fromName            String?
  replyTo             String?
  /// AES-256-GCM ciphertext.
  secretEnc           String?
  smtpHost            String?
  smtpPort            Int?
  smtpUser            String?
  smtpSecure          Boolean   @default(true)
  /// Accounts are usable before verifying while no provider is configured.
  requireVerification Boolean   @default(false)
  lastError           String?
  lastTestAt          DateTime?
  updatedAt           DateTime  @updatedAt
}
