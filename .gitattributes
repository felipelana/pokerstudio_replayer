* text=auto eol=lf

# Hand histories a reader downloads are opened in Notepad, so they keep the
# line ending Windows expects.
*.txt text eol=crlf

# The ones the tests read are not prose, they are evidence. Their bytes decide
# the hand ids, and one of them is a real dealer export whose CRLF, BOM and
# trailing spaces are the very thing a test asserts. Git converts none of it:
# what was committed is what lands on disk, on every machine.
apps/web/src/parsers/**/fixtures/* -text
