# Where every "Try it free" button points.
#
# Leave it unset and the page decides by itself: a page served from localhost or
# a private address sends visitors to VITE_REPLAYER_URL_DEV, and anything else
# (a real domain) sends them to the production replayer. A production build
# therefore never sends a visitor to localhost, even by accident.
#
# Set it only to override that, for example on a staging host.
VITE_REPLAYER_URL=

# Defaults, both overridable per environment.
VITE_REPLAYER_URL_PROD=https://replayer.pokerstudio.com.br
VITE_REPLAYER_URL_STAGING=https://stage.replayer.pokerstudio.com.br
VITE_REPLAYER_URL_DEV=http://localhost:5173

# The institutional site linked from the header and the footer.
VITE_SITE_URL=https://pokerstudio.com.br
