# Tudo o que a aplicação precisa para subir. Copie para .env na raiz e preencha.
# Nenhum valor real entra neste arquivo: ele é versionado.

# ---- obrigatórios ----
NODE_ENV=development
PORT=3100
# O Postgres local. Em produção, o container.
DATABASE_URL="postgresql://pokerstudio:SENHA@localhost:5432/pokerstudio_dev?schema=public"
# Assina o cookie de sessão. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
# Cifra o que é guardado cifrado, como o segredo do TOTP. Gere do mesmo jeito.
ENCRYPTION_KEY=""
# O endereço em que o navegador está. A guarda de CSRF compara a origem com ele,
# então em desenvolvimento com o Next isto é http://localhost:3100.
APP_URL="http://localhost:3100"

# ---- conta e e-mail ----
ADMIN_EMAILS=""
EMAIL_FROM="nao-responda@pokerstudio.com.br"
EMAIL_FROM_NAME="PokerStudio Replayer"
# Resend. Sem chave, os e-mails ficam na caixa de saída e não saem.
EMAIL_PROVIDER_KEY=""

# ---- entrada por provedor, opcional ----
# Sem as três variáveis de um provedor, o botão dele aparece como "em breve".
# Como criar cada app: docs/oauth-local.md
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3100/api/v1/auth/google/callback"

FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_REDIRECT_URI="http://localhost:3100/api/v1/auth/facebook/callback"

# A Apple não aceita localhost: exige HTTPS num domínio verificado.
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
APPLE_REDIRECT_URI=""

# ---- opcionais ----
COOKIE_DOMAIN=""
TURNSTILE_SECRET=""
REVIEW_UPLOADS_PER_DAY="20"
ERROR_LOG_RETENTION_DAYS="30"

# ---- landing, lidas pelo navegador ----
NEXT_PUBLIC_SITE_URL="https://pokerstudio.com.br"
NEXT_PUBLIC_REPLAYER_URL_PROD="https://replayer.pokerstudio.com.br"
NEXT_PUBLIC_REPLAYER_URL_DEV="http://localhost:3100"
